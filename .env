# URL API
# example: https://message-hub-web-example.com
VUE_APP_API_BASE_URL=http://127.0.0.1:8000
#  не забудь поиенять process.env.VUE_APP_API_BASE_URL.replace(/^http/, 'ws') + '/ws_listener'

# Путь для регистрации
VUE_APP_AUTH_REGISTER_URL=/auth/register

# Путь для логина
VUE_APP_AUTH_LOGIN_URL=/auth/jwt/login

# Путь для загрузки файла
VUE_APP_FILE_UPLOAD_URL=/upload_file

# URL для WebSocket соединений (будет заменен в vue.config.js)
# VUE_APP_WS_URL=wss://placeholder/ws_listener