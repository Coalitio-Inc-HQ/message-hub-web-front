# URL API
# example: https://message-hub-web-example.com
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_LISTMER_URL="/ws_listener"
#  не забудь поиенять process.env.VITE_API_BASE_URL.replace(/^http/, 'ws') + '/ws_listener'

# Путь для регистрации
VITE_AUTH_REGISTER_URL=/auth/register

# Путь для логина
VITE_AUTH_LOGIN_URL="/auth/login"
VITE_USER_INFO_URL="/auth/user/info"
VITE_USER_SET_SETTINGS_URL="/auth/user/settings/set"

VITE_USER_LIST_URL="/auth/user/list"
VITE_USER_CREATE_URL="/auth/user/create"
VITE_USER_UPDATE_URL="/auth/user/update"
VITE_USER_DELETE_URL="/auth/user/delete"

VITE_ROLE_LIST_URL="/auth/role/list"
VITE_ROLE_CREATE_URL="/auth/role/create"
VITE_ROLE_UPDATE_URL="/auth/role/update"
VITE_ROLE_DELETE_URL="/auth/role/delete"

# Путь для загрузки файла
VITE_FILE_UPLOAD_URL=/upload_file

# URL для WebSocket соединений (будет заменен в vue.config.js)
# VITE_WS_URL=wss://placeholder/ws_listener

VITE_TG_BOT_REF=XXXXXXXX